# Scripts — ignore scratch/ops utilities by default, but TRACK the ones CI and
# the pre-commit hook invoke (otherwise those gates fail on a clean checkout).
scripts/*
!scripts/deploy-vps.sh
!scripts/validate-kb.ts
!scripts/validate-claims.ts
!scripts/scan-secrets.ts
!scripts/scan-prohibited-phrases.ts
!scripts/load-test.ts

# Test files — the suite + config must be tracked so CI `pnpm test` runs.
# (e2e/playwright stay ignored until that suite is committed.)
e2e/
playwright.config.ts

# Images / screenshots
*.png
*.jpg
*.jpeg

# Research / reference tiers
tiers/

# Infrastructure config
infrastructure/

# Docker — tracked (required for VPS deployment)

# Skills tooling (taste-skill etc.) — not part of the app
skills-lock.json
.agents/
