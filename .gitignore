yarn-error.log*

# Vercel
.vercel

# Claude Code
.claude/

# Documentation / planning (not source code)
*.md
!README.md
!kb/**/*.md

# Scripts — ignore scratch/ops utilities by default, but TRACK the ones CI and
# the pre-commit hook invoke (otherwise those gates fail on a clean checkout).
scripts/*
!scripts/deploy-vps.sh
!scripts/validate-kb.ts
!scripts/validate-claims.ts
!scripts/scan-secrets.ts
!scripts/scan-prohibited-phrases.ts
!scripts/load-test.ts

# Test files — the suite + config must be tracked so CI `pnpm test` runs.
# (e2e/playwright stay ignored until that suite is committed.)
e2e/
playwright.config.ts

# Images / screenshots
*.png
*.jpg
*.jpeg

# Research / reference tiers
tiers/

# Infrastructure config
infrastructure/

# Docker — tracked (required for VPS deployment)

# Skills tooling (taste-skill etc.) — not part of the app
skills-lock.json
.agents/

# Local key-generation artifacts (never commit private keys). The former
# JWT_PRIVATE_KEY tooling is retired — Better Auth uses a static JWKS generated
# on the deployment (npx convex run auth:generateJwk). Kept ignored defensively.
.jwt_private_key.tmp
.jwks.tmp
writeKeys.mjs
generateKeys.mjs

# Scratch HTML (SEO audit exports, previews) — never commit.
index.html

# Auth key-generation scratch output — a generated JWKS doc contains the PRIVATE
# key. Never commit. The static JWKS lives only in the Convex function env store
# (npx convex env set JWKS). error.md is local terminal-output scratch.
jwks.json
empty.jsonl
error.md
convex-compose-coolify.txt
