{
  "name": "resolvaio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "validate-kb": "tsx scripts/validate-kb.ts",
    "scan-phrases": "tsx scripts/scan-prohibited-phrases.ts",
    "validate-claims": "tsx scripts/validate-claims.ts",
    "compliance-check": "pnpm scan-phrases && pnpm validate-claims",
    "scan-secrets": "tsx scripts/scan-secrets.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "workers": "tsx src/workers/index.ts",
    "test:e2e": "playwright test",
    "test:load": "tsx scripts/load-test.ts",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/r2": "^0.10.2",
    "@oslojs/crypto": "^1.0.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.53.1",
    "archiver": "^8.0.0",
    "bullmq": "^5.31.0",
    "clsx": "^2.1.1",
    "convex": "^1.44.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "openai": "^4.77.0",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.12.3",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.4",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.21",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
